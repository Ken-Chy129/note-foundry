# Local deployed stack. Use HTTPS and external S3-compatible storage in production.
APP_ENV=development
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost:8088
HTTP_PORT=8088
HTTPS_PORT=8443

GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_OWNER_ID=123456789

POSTGRES_DB=notefoundry
POSTGRES_USER=notefoundry
POSTGRES_PASSWORD=replace-this-database-password
POSTGRES_PORT=54329
DATABASE_URL=postgres://notefoundry:replace-this-database-password@postgres:5432/notefoundry?sslmode=disable
TEST_DATABASE_URL=postgres://notefoundry:replace-this-database-password@localhost:54329/notefoundry?sslmode=disable

BACKUP_ENABLED=false
BACKUP_S3_ENDPOINT=minio:9000
BACKUP_S3_ACCESS_KEY=notefoundry-local
BACKUP_S3_SECRET_KEY=replace-this-minio-password
BACKUP_S3_BUCKET=notefoundry-backups
BACKUP_S3_REGION=us-east-1
BACKUP_S3_USE_SSL=false
BACKUP_PREFIX=notefoundry
BACKUP_PASSPHRASE=replace-with-a-long-unique-backup-passphrase
BACKUP_DAILY_RETENTION=7
BACKUP_WEEKLY_RETENTION=8

# Only used by the optional local-s3 profile.
MINIO_ROOT_USER=notefoundry-local
MINIO_ROOT_PASSWORD=replace-this-minio-password
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001
